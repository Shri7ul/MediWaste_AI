# Frontend configuration. Copy to `.env.local` and edit.
#
# No secrets belong in this file: every NEXT_PUBLIC_* value is inlined into the
# browser bundle at build time. Values are read when the server starts, so
# restart `npm run dev` (or rebuild) after changing them.

# --- API routing ------------------------------------------------------------
# Send API calls to the Next.js server, which forwards them to Flask (see the
# rewrite in next.config.mjs).
#
# REQUIRED for the HTTPS exhibition mode: a page served over https:// may not
# fetch http://<lan-ip>:5000 — the browser blocks it as mixed content. Routing
# through the same origin also means CORS is not involved at all.
#
# Leave this EMPTY to go back to the browser calling Flask directly, in which
# case the API origin is derived from the served page (see lib/api/client.ts).
NEXT_PUBLIC_API_BASE_URL=/backend

# Where the Next.js server forwards /backend/* . Server-side only — never shipped
# to the browser. Loopback is correct because Flask runs on the same laptop as
# the Next.js server, and it means no LAN IP is stored anywhere in the app.
BACKEND_ORIGIN=http://127.0.0.1:5000

# Only used when NEXT_PUBLIC_API_BASE_URL is empty (browser talks to Flask
# directly). Set it if Flask runs on a port other than 5000.
# NEXT_PUBLIC_API_PORT=5000
