# MediWaste AI — environment template.
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# python-dotenv loads these at startup.

# --- Roboflow (object detection) ---
ROBOFLOW_API_KEY=your-roboflow-key
MODEL_ID=medbin_dataset-fqhi7/1
# Optional; defaults to the serverless endpoint:
# ROBOFLOW_API_URL=https://serverless.roboflow.com

# --- Pinecone (RAG evidence; existing index with integrated embedding) ---
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX_NAME=brainchild
PINECONE_NAMESPACE=__default__

# --- OpenRouter (explanation layer only) ---
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Optional tuning (safe defaults exist in code) ---
# POLICY_ACCEPT_THRESHOLD=0.40
# POLICY_REVIEW_FLOOR=0.20
# RAG_TOP_K=8
# MAX_UPLOAD_MB=10
# PORT=5000
